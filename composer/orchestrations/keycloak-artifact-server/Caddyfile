icsauth.net {
    # TLS 1.2+ with automatic ACME certificate management
    tls {
        protocols tls1.2 tls1.3
    }

    # Add correlation ID for tracing
    @no_corr header X-Correlation-ID ""
    header @no_corr X-Correlation-ID {uuid}
    header X-Served-By "Caddy (Orchestration)"

    # Route 1: Artifact server (static files under /data/ics/*)
    handle_path /data/ics/* {
        root * /data/ics
        file_server browse
        
        # Security: prevent directory traversal attacks
        @blocked path /../*
        respond @blocked 403
    }

    # Route 2: Keycloak (all other paths)
    reverse_proxy ics-auth-server:8080 {
        # Preserve original request headers for Keycloak
        header_up X-Forwarded-Proto https
        header_up X-Forwarded-Port 443
    }

    # Structured JSON logging with rotation (mirrors service-level)
    log {
        output file /var/log/caddy/access.log {
            roll_size 10MB
            roll_keep 7
            roll_keep_for 720h
        }
        format json
    }
}