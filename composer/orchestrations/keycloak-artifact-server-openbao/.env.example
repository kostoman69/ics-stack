# Copy to the protected .env and supply deployment values; never commit real credentials.
POSTGRES_USER=REPLACE_ME
POSTGRES_PASSWORD=REPLACE_ME
KEYCLOAK_ADMIN=REPLACE_ME
KEYCLOAK_ADMIN_PASSWORD=REPLACE_ME
CF_API_TOKEN=REPLACE_ME
ICS_OPENBAO_TOKEN=REPLACE_ME
ICS_OPENBAO_BASE_URL=http://openbao:8200
ICS_OPS_IMAGE=icsops:26.10.5
ICS_OPS_PLATFORM=linux/amd64
# Required: supply a strong shared machine credential through protected configuration.
ICS_OPS_API_KEY=
ICS_OPS_PUBLIC_BASE_URL=https://icsauth.net/ics/ops
# Set to ics-operations only after configuring the Keycloak OIDC client.
ICS_OPS_DASHBOARD_CLIENT_ID=
ICS_OPS_DASHBOARD_CLIENT_SECRET=
ICS_OPS_DASHBOARD_ISSUER=https://icsauth.net/realms/ics
ICS_OPS_DASHBOARD_URL=https://icsauth.net/operations
ICS_OPS_DASHBOARD_IDP=shibboleth
ICS_OPS_ARTIFACT_HEALTH_URL=https://icsauth.net/data/ics/11-backend/
ICS_OPS_POSTGRES_PROBE_HOST=postgres
ICS_OPS_POSTGRES_PROBE_PORT=5432
ICS_OPS_LETSENCRYPT_ENABLED=true
ICS_OPS_ICSSUITE_ZONE=icssuite.gr
ICS_OPS_ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
ICS_OPS_ACME_ALLOW_PRODUCTION=true
ICS_OPS_CADDY_PROBE_HOST=caddy
ICS_OPS_CADDY_PROBE_PORT=443
